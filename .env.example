# NetFold 3D Server-Side TTS & Environment Configuration Example
# Copy this file to `.env` for local cloud TTS testing. NEVER commit real secrets to Git.

# Local Node TTS Proxy Server Port
TTS_PORT=8787

# Optional Python 3.12 executable path if not using `py -3.12` on Windows
# PYTHON_TTS_BIN=python3

# Option A: Google Cloud Text-to-Speech API Key (supports en-IN, kn-IN, ta-IN, te-IN, hi-IN)
GOOGLE_TTS_API_KEY=

# Option B: MeitY Bhashini ULCA / Dhruva API Credentials (supports kn, ta, te, hi)
BHASHINI_USER_ID=
BHASHINI_ULCA_API_KEY=
BHASHINI_PIPELINE_ID=64392f96daac500b55c543cd
